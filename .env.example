# ============================================
# ArkWallet Environment Variables
# ============================================

# Database Provider: "SQLite" or "PostgreSQL"
Database__Provider=SQLite

# Connection String (для PostgreSQL)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=arkwallet;Username=arkwallet;Password=arkwallet

# JWT Authentication (минимум 32 символа)
Jwt__SecretKey=your-super-secret-key-minimum-32-characters-long

# Metrics API Key (Bearer-токен для доступа к /metrics; должен совпадать с prometheus.yml)
Metrics__ApiKey=change-me-metrics-api-key

# Grafana admin login (пароль = Metrics__ApiKey, регистрация новых пользователей отключена)
GRAFANA_ADMIN_USER=admin

# Telegram Bot
Telegram__BotToken__Main=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
Telegram__AdminId__Main=123456789
Telegram__AdminId__Addition=987654321
Telegram__AdminId__AdditionThird=555555555
Telegram__AllowedUserIds=111111111,222222222
# Опционально: URL Cloudflare-proxy для Bot API (обязателен, если прямой api.telegram.org недоступен)
Telegram__BaseUrl=
# Вебхук: если задан, бот регистрирует его вместо поллинга (рекомендуется вместо getUpdates)
Telegram__WebhookUrl=https://arkwallet.ru/bot/webhook
# Секрет для проверки заголовка X-Telegram-Bot-Api-Secret-Token (1-256 символов)
Telegram__WebhookSecret=your-secret-token-here

# RabbitMQ
RabbitMQ__UserName=guest
RabbitMQ__Password=guest
RabbitMQ__HostName=localhost