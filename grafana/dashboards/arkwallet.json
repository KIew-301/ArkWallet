      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true }
      },
      "targets": [
        {
          "expr": "sum by (lock_type) (rate(arkwallet_lock_wait_seconds_count[$__rate_interval]))",
          "legendFormat": "{{lock_type}} (count/s)",
          "refId": "A"
        },
        {
          "expr": "sum by (lock_type) (rate(arkwallet_lock_wait_seconds_sum[$__rate_interval])) / sum by (lock_type) (rate(arkwallet_lock_wait_seconds_count[$__rate_interval]))",
          "legendFormat": "{{lock_type}} (avg s)",
          "refId": "B"
        }
      ],
      "title": "Lock wait",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
