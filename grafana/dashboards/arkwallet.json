        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true }
      },
      "targets": [
        {
          "expr": "sum by (lock_type) (histogram_quantile(0.95, sum by (le, lock_type) (rate(arkwallet_lock_wait_seconds_bucket[$__rate_interval]))))",
          "legendFormat": "{{lock_type}} p95",
          "refId": "A"
        }
      ],
      "title": "Lock wait p95",
      "type": "timeseries"
    },
